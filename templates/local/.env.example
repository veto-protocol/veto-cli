# ── Veto ──
# Get from `veto register` (run it once, then copy the API key + agent ID).
VETO_API_KEY=
VETO_AGENT_ID=
VETO_BASE_URL=https://veto-ai.com

# ── LLM Brain ──
# Which provider the agent reasons with. The brain (src/brain.ts) reads this
# and uses the matching API key below. Options: anthropic | openai | grok
LLM_PROVIDER=anthropic

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# xAI Grok — https://console.x.ai/
XAI_API_KEY=

# ── Wallet (local viem) ──
# A 32-byte hex-encoded private key (0x-prefixed). `veto agent init` generates
# one for you at scaffold time and writes it here. You own the key — no third
# party (no Coinbase, no Privy) holds it.
#
# Treat this file like the password it is. Never commit .env to git.
WALLET_PRIVATE_KEY=

# RPC endpoint. Use a public Base RPC for testing, swap for Alchemy/Infura
# in production for reliability + rate limits.
RPC_URL=https://mainnet.base.org

# ── Network ──
# base-mainnet for real money. base-sepolia for testnet (free, get faucet ETH/USDC).
NETWORK=base-mainnet
CHAIN_ID=8453

# ── Hard-stop (optional, opt-in) ──
# When set, governed wallet actions go through a deployed VetoGuardedAccount
# instead of the EOA. The contract holds the funds and refuses to release
# them without a fresh, in-scope, Veto-signed mandate. Even a compromised
# agent can't move funds.
#
# To upgrade:
#   1. Deploy a VetoGuardedAccount (see contracts/README.md in the Veto repo)
#   2. Fund it with ETH for gas + the tokens you want the agent to spend
#   3. Set WALLET_CONTRACT below to its address
#
# Leave empty to stay in cooperative mode (Veto's deny halts the agent
# before broadcast, but the EOA itself could still send if something
# bypassed the agent code).
WALLET_CONTRACT=

# ── Runtime mode ──
# chat   = CLI REPL (you type to the agent in your terminal). Use locally.
# server = HTTP server on PORT, exposes POST /chat. Use for 24/7 deployments.
MODE=chat
PORT=8080
