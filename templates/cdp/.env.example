# ── Veto ──
# Get from `veto register` (run it once, then copy the API key + agent ID).
VETO_API_KEY=
VETO_AGENT_ID=
VETO_BASE_URL=https://veto-ai.com

# ── LLM Brain ──
# Which provider the agent reasons with. The brain (src/brain.ts) reads this
# and uses the matching API key below. Options: anthropic | openai | grok
LLM_PROVIDER=anthropic

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# xAI Grok — https://console.x.ai/
XAI_API_KEY=

# ── Coinbase CDP ──
# Get from https://portal.cdp.coinbase.com/projects/api-keys
# Used for: smart-account wallet provisioning + x402 facilitator + Base RPC.
#
# CDP_API_KEY_ID:     a UUID (e.g. 1d6bfd3c-e89f-41e8-...). The 'Name' field
#                     in the portal is just a label — the SDK uses this UUID.
# CDP_API_KEY_SECRET: a long base64-ish string the portal shows ONCE on creation.
# CDP_WALLET_SECRET:  separate from API key secret. Authorizes signing
#                     transactions with a CDP-managed wallet. REQUIRED for
#                     the agent to actually send transactions. Without it,
#                     the agent is read-only (can check balances, view state,
#                     but cannot move money). Get it from the CDP portal
#                     at the same time you create your wallet.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Wallet — `veto agent init` will provision this for you and write back here.
# Don't edit by hand unless you really know what you're doing.
CDP_WALLET_ADDRESS=
CDP_WALLET_ID=

# ── Runtime mode ──
# chat   = CLI REPL (you type to the agent in your terminal). Use locally.
# server = HTTP server on PORT, exposes POST /chat. Use for 24/7 deployments.
MODE=chat
PORT=8080

# ── Network ──
# base-mainnet for real money. base-sepolia for testnet (free, get faucet USDC).
NETWORK=base-mainnet
